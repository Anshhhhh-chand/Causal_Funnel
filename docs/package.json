{
  "name": "causalfunnel-user-analytics",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/dashboard",
    "packages/contracts",
    "packages/tracker"
  ],
  "scripts": {
    "dev:api": "npm --workspace @causalfunnel/api run dev",
    "dev:dashboard": "npm --workspace @causalfunnel/dashboard run dev",
    "build": "npm run build:contracts && npm run build:tracker && npm run build:api && npm run build:dashboard",
    "build:contracts": "npm --workspace @causalfunnel/contracts run build",
    "build:tracker": "npm --workspace @causalfunnel/tracker run build",
    "build:api": "npm --workspace @causalfunnel/api run build",
    "build:dashboard": "npm --workspace @causalfunnel/dashboard run build",
    "test": "npm run test:contracts && npm run test:tracker && npm run test:api && npm run test:dashboard",
    "test:contracts": "npm --workspace @causalfunnel/contracts run test",
    "test:tracker": "npm --workspace @causalfunnel/tracker run test",
    "test:api": "npm --workspace @causalfunnel/api run test",
    "test:dashboard": "npm --workspace @causalfunnel/dashboard run test",
    "typecheck": "npm run typecheck:contracts && npm run typecheck:tracker && npm run typecheck:api && npm run typecheck:dashboard",
    "typecheck:contracts": "npm --workspace @causalfunnel/contracts run typecheck",
    "typecheck:tracker": "npm --workspace @causalfunnel/tracker run typecheck",
    "typecheck:api": "npm --workspace @causalfunnel/api run typecheck",
    "typecheck:dashboard": "npm --workspace @causalfunnel/dashboard run typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
